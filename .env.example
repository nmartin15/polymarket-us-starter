# Copy this file to .env and fill in your own values.
# NEVER commit .env. NEVER show it on screen.
# Create keys at https://polymarket.us/developer (the secret is shown once).

POLYMARKET_KEY_ID=your-key-id-uuid
POLYMARKET_SECRET_KEY=your-base64-secret-key

# Strategy settings (videos 2 and 3)
MARKET_SLUG=paste-a-market-slug-here
FAIR_VALUE=0.50          # YOUR probability estimate for YES (0 to 1)
MIN_EDGE=0.04            # taker: only trade when edge beats the fee by this much
QUOTE_OFFSET=0.03        # maker (video 3): how far from fair value to rest quotes
TAKER_FEE_RATE=0.095     # your taker fee tier: 0.095 under $10K of 30-day volume. See docs.polymarket.us/fees
ORDER_SIZE=10            # contracts per trade
MAX_POSITION=50          # max contracts held
MAX_DAILY_LOSS=25        # dollars; bot stops if paper P&L hits -this
POLL_SECONDS=10
