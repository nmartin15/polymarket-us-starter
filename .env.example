# Copy this file to .env and fill in your own values.
# NEVER commit .env. NEVER show it on screen.
# Create your key at https://polymarket.us/developer (the secret is shown once).

POLYMARKET_KEY_ID=your-key-id
POLYMARKET_SECRET_KEY=your-secret-key

# Your taker fee tier, by 30-day taker volume: 0.095 under $10K, 0.085, 0.075, 0.0695 above $250K.
# Used only for the fee estimates the scripts print. See https://docs.polymarket.us/fees
TAKER_FEE_RATE=0.095

# Video 3 guard rails for real orders
MAX_LIVE_CONTRACTS=1
HOLD_SECONDS=10
